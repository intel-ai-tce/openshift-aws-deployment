# OpenShift on AWS configuration template.
# Copy this file OUTSIDE the repository, for example:
#   ~/.config/openshift-aws/config.env
# Then set CONFIG_FILE to that path, or use the default above.
#
# Do not store AWS secret keys, pull secrets, private SSH keys, kubeconfigs,
# or kubeadmin passwords in this file or in the Git repository.

# AWS identity and region
AWS_PROFILE=""
AWS_REGION=""
AWS_ACCOUNT_ID=""

# Existing AWS networking
VPC_ID=""
PRIVATE_SUBNET_ID=""
PUBLIC_SUBNET_ID=""
AVAILABILITY_ZONE=""
EXTRA_SECURITY_GROUP_ID=""
MACHINE_NETWORK_CIDR=""

# Private OpenShift DNS
BASE_DOMAIN=""
HOSTED_ZONE_ID=""
CLUSTER_NAME=""

# OpenShift cluster sizing
CONTROL_PLANE_REPLICAS="3"
WORKER_REPLICAS="2"
CONTROL_PLANE_INSTANCE_TYPE="m8i.4xlarge"
WORKER_INSTANCE_TYPE="m8i.24xlarge"
ROOT_VOLUME_TYPE="gp3"
ROOT_VOLUME_SIZE_GIB="120"

# Local input files. These paths intentionally live outside the repository.
PULL_SECRET_FILE="$HOME/.config/openshift-aws/pull-secret.txt"
SSH_PRIVATE_KEY="$HOME/.ssh/ocp-bastion"
SSH_PUBLIC_KEY="$HOME/.ssh/ocp-bastion.pub"

# Public bastion
BASTION_NAME="ocp-public-bastion"
BASTION_INSTANCE_TYPE="m8i.large"
BASTION_KEY_NAME="ocp-bastion-key"
BASTION_REMOTE_DIR="/home/ec2-user/openshift-aws-deployment"

# Optional SOCKS5 proxy for SSH/SCP from the workstation to the bastion.
# Leave SSH_PROXY_HOST empty for direct SSH.
# Intel example:
#   SSH_PROXY_HOST="proxy-us.intel.com"
#   SSH_PROXY_PORT="1080"
SSH_PROXY_HOST=""
SSH_PROXY_PORT="1080"

# Relative path is resolved under this repository directory.
INSTALL_DIR="cluster"

# Containerized toolbox
OCP_CHANNEL="stable-4.20"
OCP_TOOLBOX_IMAGE="ocp-aws-toolbox:4.20"
